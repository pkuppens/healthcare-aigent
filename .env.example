# OpenAI Configuration
OPENAI_API_KEY="your-api-key-here"
OPENAI_MODEL_NAME="gpt-3.5-turbo"

# Ollama Configuration (optional)
# OLLAMA_BASE_URL="http://127.0.0.1:11434"  # 127.0.0.1, not localhost: avoids a ~2 s IPv6 fallback per connection on Windows
# OLLAMA_MODEL_NAME="llama3"  # only for get_llm(); local model profiles live in config/llm_profiles.yml

# LLM Provider Selection
LLM_PROVIDER="OPENAI"  # or "OLLAMA" 

# Logging Configuration
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE="logs/crewai_llm.log"  # Path to log file, or empty for console only 

# UV Configuration
UV_PYTHON=3.11  # Recommended Python version for development 

# LangFlow Configuration
DO_NOT_TRACK=true
LANGFLOW_CONFIG_DIR=src/langflow_poc/workflows
LANGFLOW_SECRET_KEY=your_secret_key_here
LANGFLOW_STORE=true
LANGFLOW_STORE_ENVIRONMENT_VARIABLES=true
LANGFLOW_PROFILE_PICTURES_DIR=src/langflow_poc/profile_pictures

# Langfuse observability (optional, default-off; see docs/langfuse.md)
# Needs `uv sync --extra observability` and the local stack from docker-compose.langfuse.yml.
# Before #16 lands, enabled tracing sends prompts and outputs unmasked: use synthetic data only.
LANGFUSE_ENABLED=false
# LANGFUSE_HOST="http://localhost:3000"
# LANGFUSE_PUBLIC_KEY="pk-lf-local-dev"   # local-stack defaults; replace for any other instance
# LANGFUSE_SECRET_KEY="sk-lf-local-dev"
# LANGFUSE_SAMPLE_RATE=1.0               # fraction of traces to keep, 0.0-1.0
# LANGFUSE_DEBUG=false
# LANGFUSE_MASK_PII=true                 # best-effort PII masking before export (docs/langfuse.md section 4)
