# Optional overrides for docker-compose.langfuse.yml. Copy to .env.langfuse (gitignored) and run:
#   docker compose --env-file .env.langfuse -f docker-compose.langfuse.yml up -d
# Every value has a local-dev default in the compose file; set only what you need to change.

# LANGFUSE_PORT=3000
# MINIO_PORT=9190

# Bootstrap login and project API keys (only applied on first boot of an empty database).
# LANGFUSE_INIT_USER_EMAIL=admin@langfuse.local
# LANGFUSE_INIT_USER_PASSWORD=langfuse-local-dev
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-dev
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-dev

# Internal secrets. Generate with `openssl rand -hex 32` if this instance is ever reachable by others.
# NEXTAUTH_SECRET=
# SALT=
# ENCRYPTION_KEY=
# POSTGRES_PASSWORD=
# CLICKHOUSE_PASSWORD=
# MINIO_ROOT_PASSWORD=
# REDIS_AUTH=
